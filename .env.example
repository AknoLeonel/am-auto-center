NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Push e resumo diário (opcional). Gere as chaves com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br
# Só no servidor (Settings > API > service_role). Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Mapa "Venha nos visitar" (Google Maps Locator Plus). Sem a chave, o mapa não aparece.
# Restrinja a chave por domínio (HTTP referrers) no Google Cloud: ela fica visível no navegador.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opcional: Map ID criado no Google Cloud (Map Management). Vazio usa DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
